SERVER_PORT=25565

EULA="TRUE"
TYPE="FORGE"
VERSION="1.20.1"

MEMORY="5g"
MEMORY_LIMIT="6g"
MAX_PLAYERS="10"
VIEW_DISTANCE="8"
SIMULATION_DISTANCE="6"

MOTD="WELCOME TO MY MINECRAFT SERVER! Docker Compose by https://github.com/acanodev"
MODE="survival"
DIFFICULTY="normal"
PVP="true"
ONLINE_MODE="TRUE"

ENABLE_WHITELIST="TRUE"
ENFORCE_WHITELIST="TRUE"
WHITELIST="user1,user2"
OPS="user1,user2"

ENABLE_RCON="TRUE"
RCON_PASSWORD="change_this"

TZ="Europe/Madrid"

ICON="/icon/icon.png"
OVERRIDE_ICON="true"

BACKUP_NAME="minecraft"
BACKUP_INTERVAL="24h"
INITIAL_DELAY="2m"
PRUNE_BACKUPS_DAYS="14"